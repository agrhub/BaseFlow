PORT=5001
HOST=localhost
NODE_ENV=development

# ---- Security (REQUIRED when NODE_ENV=production; the server refuses to start otherwise) ----
# Login password (>= 8 chars, not "admin")
PASSWORD=change_me_strong_password
# Generate with: openssl rand -hex 32  — keep ENCRYPTION_KEY stable, it protects stored Git tokens
ENCRYPTION_KEY=
SESSION_SECRET=
# Extra origins allowed to call the API with cookies (comma separated). Dev default: http://localhost:5173
#CORS_ORIGINS=https://baseflow.example.com
# Folders that "local" connections may point to (comma separated).
# Unset = any folder in development, local connections DISABLED in production.
#ALLOWED_LOCAL_ROOTS=/home/me/projects
# Agent conversations (chat history + agent context). Unset = in memory, lost on restart.
#   sqlite:///absolute/path/agent_sessions.db  - single host / single instance
#   postgres://user:pass@host:5432/baseflow     - several instances (e.g. Cloud SQL)
#SESSION_DB_URL=sqlite:///var/lib/baseflow/agent_sessions.db

# Frontend dev server API target
VITE_API_URL=http://localhost:5001

# Google ADK
GOOGLE_API_KEY=your_google_agent_api_key
AGENT_MODEL=gemini-3.1-flash-lite
GOOGLE_CLOUD_PROJECT=your_google_cloud_project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=1
GEMINI_CLI_MODEL=gemini-2.5-flash
# Gemini CLI playbooks auto-approve file edits only (auto_edit); shell commands are not run.
# Set to "yolo" to auto-approve everything (unsafe with untrusted repositories / issues).
#GEMINI_CLI_APPROVAL_MODE=auto_edit

# ---- Chat model providers (any combination; only configured ones are offered in the chat) ----
# Default provider for the chat and for text generation (README / class / document analysis):
# gemini | anthropic | openai. Unset = first configured provider.
#LLM_PROVIDER=gemini
# Claude (Anthropic)
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
#ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (Claude API only); set to "off" behind a proxy that rejects it
#ANTHROPIC_SERVER_FALLBACK=on
# OpenAI (or any OpenAI-compatible endpoint via OPENAI_BASE_URL)
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-5.5
#OPENAI_BASE_URL=
#OPENAI_REASONING_EFFORT=
#GOOGLE_APPLICATION_CREDENTIALS=gcp-project-service-account.json
